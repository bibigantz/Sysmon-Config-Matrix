<!--
  Sysmon Configuration
  Generated by: Cyber Guard Forte (cyberguardforte.com)
  Preset: balanced
  Generated: 2026-10-12T09:31:57.098Z

  Deployment:
    Install:  sysmon64.exe -accepteula -i sysmonconfig.xml
    Update:   sysmon64.exe -c sysmonconfig.xml
    Verify:   Get-Service Sysmon64

  IMPORTANT: Test in a non-production environment first.
  Tune exclusions for YOUR environment before broad deployment.
-->
<Sysmon schemaversion="4.90">

  <!-- Capture all hashes for file and process events -->
  <HashAlgorithms>md5,sha256,IMPHASH</HashAlgorithms>

  <!-- Enable DNS query logging -->
  <DnsLookup>True</DnsLookup>

  <!-- Archive deleted files to Sysmon archive (needs disk space) -->
  <!-- <ArchiveDirectory>C:\Sysmon</ArchiveDirectory> -->

  <EventFiltering>

  <!-- Event ID 1: Process Creation -->
  <EventFiltering>
    <ProcessCreate onmatch="exclude">
      <!-- SCCM/Intune exclusions -->
      <ProcessCreate onmatch="exclude">
        <Image condition="contains">\CcmExec.exe</Image>
        <Image condition="contains">\CmRcService.exe</Image>
        <Image condition="contains">\Microsoft Intune Management Extension</Image>
      </ProcessCreate>
      <!-- Exclude noisy Windows system processes -->
      <Image condition="contains">\Windows\System32\backgroundTask</Image>
      <CommandLine condition="contains">\Windows\system32\wbem\wmiprvse.exe</CommandLine>
    </ProcessCreate>
  </EventFiltering>

  <!-- Event ID 3: Network Connection -->
  <!-- Note: High volume. Tune by excluding known management traffic -->
  <NetworkConnect onmatch="exclude">
    <Image condition="contains">\MsMpEng.exe</Image>
    <DestinationPort condition="is">443</DestinationPort><!-- Remove to catch C2 on 443 -->
    <Image condition="contains">\svchost.exe</Image>
  </NetworkConnect>

  <!-- Event ID 6: Driver Loaded -->
  <!-- Only include signed drivers by default; alert on unsigned -->
  <DriverLoad onmatch="exclude">
    <Signature condition="contains">Microsoft</Signature>
    <Signature condition="contains">Windows</Signature>
  </DriverLoad>

  <!-- Event ID 8: CreateRemoteThread -->
  <!-- Very low false positive rate. Include all. -->
  <CreateRemoteThread onmatch="exclude">
    <SourceImage condition="contains">\Google\Chrome</SourceImage>
  </CreateRemoteThread>

  <!-- Event ID 10: ProcessAccess (LSASS protection) -->
  <ProcessAccess onmatch="include">
    <TargetImage condition="contains">lsass.exe</TargetImage>
  </ProcessAccess>
  <ProcessAccess onmatch="exclude">
    <SourceImage condition="contains">\MsMpEng.exe</SourceImage>
    <SourceImage condition="contains">\csagent.exe</SourceImage>
    <SourceImage condition="contains">\CylanceSvc.exe</SourceImage>
    <GrantedAccess condition="is">0x1000</GrantedAccess><!-- Task Manager query only -->
  </ProcessAccess>

  <!-- Event ID 12/13/14: Registry Events -->
  <RegistryEvent onmatch="include">
    <TargetObject condition="contains">\CurrentVersion\Run</TargetObject>
    <TargetObject condition="contains">\CurrentVersion\RunOnce</TargetObject>
    <TargetObject condition="contains">\Winlogon\Shell</TargetObject>
    <TargetObject condition="contains">\Image File Execution Options</TargetObject>
    <TargetObject condition="contains">\AppCertDLLs</TargetObject>
    <TargetObject condition="contains">\AppInit_DLLs</TargetObject>
  </RegistryEvent>

  <!-- Event ID 17/18: Pipe Events (Cobalt Strike detection) -->
  <PipeEvent onmatch="include">
    <PipeName condition="contains">\msagent_</PipeName>
    <PipeName condition="contains">\mojo.</PipeName>
    <PipeName condition="contains">\postex_</PipeName>
    <PipeName condition="contains">\status_</PipeName>
    <PipeName condition="contains">\mypipe-</PipeName>
  </PipeEvent>

  <!-- Event ID 19/20/21: WMI Events -->
  <!-- All WMI subscriptions are suspicious outside known management tools -->
  <WmiEvent onmatch="exclude">
    <Operation condition="contains">SCM Event Log Consumer</Operation>
  </WmiEvent>

  <!-- Event ID 22: DNS Query -->
  <DnsQuery onmatch="exclude">
    <QueryName condition="contains">.microsoft.com</QueryName>
    <QueryName condition="contains">.windows.com</QueryName>
    <QueryName condition="contains">.windowsupdate.com</QueryName>
  </DnsQuery>

  <!-- Event ID 25: Process Tampering (Hollowing/Doppelganging) -->
  <!-- No exclusions needed - very high fidelity -->

  </EventFiltering>

</Sysmon>